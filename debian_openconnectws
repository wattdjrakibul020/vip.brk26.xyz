install_require () {
    clear
    echo "Installing dependencies (Debian 11/12)..."

    {
        export DEBIAN_FRONTEND=noninteractive

        # Ensure Debian
        . /etc/os-release
        [ "$ID" != "debian" ] && return

        apt update -y

        # Core utilities
        apt install -y curl wget cron python3 python-is-python3
        apt install -y jq unzip dos2unix nano screen neofetch vnstat
        apt install -y net-tools mlocate virt-what httpie netcat

        # Network / security
        apt install -y iptables fail2ban squid stunnel4 dropbear gnutls-bin

        # Radius / database
        apt install -y freeradius freeradius-mysql freeradius-utils
        apt install -y default-mysql-client php

        # VPN / proxy
        apt install -y ocserv

        # Build / dev tools
        apt install -y build-essential dh-make libaudit-dev

        # Enable services quietly
        systemctl enable cron 2>/dev/null
        systemctl enable vnstat 2>/dev/null
        systemctl enable fail2ban 2>/dev/null

        updatedb 2>/dev/null
        clear
    } &>/dev/null

    clear
    echo "Dependencies installed."
}


