detect_distro() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        DISTRO=$ID
        VERSION=$VERSION_ID
    else
        echo "[ERROR] Cannot detect distribution."
        exit 1
    fi
    echo "[INFO] Detected: $DISTRO $VERSION"
}

install_pkg() {
    if ! dpkg -s "$1" >/dev/null 2>&1; then
        echo "[INFO] Installing: $1"
        apt-get install -yq "$1"
    else
        echo "[INFO] Already installed: $1"
    fi
}

setup_nodejs() {
