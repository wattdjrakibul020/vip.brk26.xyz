install_ssl() {
    echo "[INFO] Installing SSL (Let's Encrypt via acme.sh)"

    mkdir -p /etc/xray

    # Stop nginx temporarily (safe)
    systemctl stop nginx || true

    # Install official acme.sh
    curl -fsSL https://get.acme.sh | sh -s email=admin@"$DOMAIN"

    export PATH="$HOME/.acme.sh:$PATH"

    ~/.acme.sh/acme.sh --set-default-ca --server letsencrypt

    # Issue ECC certificate
    ~/.acme.sh/acme.sh --issue \
        -d "$DOMAIN" \
        --standalone \
        -k ec-256

    # Install cert for Xray
    ~/.acme.sh/acme.sh --install-cert \
        -d "$DOMAIN" \
        --ecc \
        --fullchain-file /etc/xray/xray.crt \
        --key-file /etc/xray/xray.key \
        --reloadcmd "systemctl restart xray nginx"

    chmod 600 /etc/xray/xray.key
    chown firenet:firenet /etc/xray/xray.key /etc/xray/xray.crt

    # Nginx configs
    wget -q -O /etc/nginx/conf.d/firenet.conf \
      "https://gitlab.com/mrakibul020/radeveloperserversc/-/raw/main/v2ray/firenet.conf"

    sed -i "s/xxx/${DOMAIN}/g" /etc/nginx/conf.d/firenet.conf

    wget -q -O /etc/nginx/nginx.conf \
      "https://gitlab.com/mrakibul020/radeveloperserversc/-/raw/main/v2ray/nginx.conf"

    wget -q -O /etc/firenet/.version \
      "https://gitlab.com/mrakibul020/radeveloperserversc/-/raw/main/v2ray/version"

    # vnStat interface fix
    vnstat -u -i "$NET" || true
    sed -i "s/^Interface .*/Interface \"${NET}\"/" /etc/vnstat.conf 2>/dev/null || true
    chown -R vnstat:vnstat /var/lib/vnstat || true

    # Restart services
    systemctl enable nginx
    systemctl restart nginx
    systemctl restart xray

    echo "[INFO] SSL installed successfully"
}


additional(){
  echo "[INFO] Applying safe optimizations..."

  # Enable BBR (native, safe)
  modprobe tcp_bbr 2>/dev/null || true
  sysctl -w net.core.default_qdisc=fq
  sysctl -w net.ipv4.tcp_congestion_control=bbr

  # Swap only if RAM < 1GB
  MEM=$(free -m | awk '/Mem:/ {print $2}')
  if [[ "$MEM" -lt 1024 ]] && ! swapon --show | grep -q swapfile; then
    fallocate -l 1G /swapfile
    chmod 600 /swapfile
    mkswap /swapfile
    swapon /swapfile
    echo "/swapfile swap swap defaults 0 0" >> /etc/fstab
  fi
}


