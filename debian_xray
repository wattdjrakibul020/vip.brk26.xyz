install_vnstat(){
    echo "[INFO] Installing vnStat from source..."

    VNSTAT_VER="2.11"

    apt-get install -y \
      build-essential libsqlite3-dev libgd-dev

    cd /tmp || exit
    curl -LO https://humdi.net/vnstat/vnstat-${VNSTAT_VER}.tar.gz
    tar xf vnstat-${VNSTAT_VER}.tar.gz
    cd vnstat-${VNSTAT_VER}

    ./configure --prefix=/usr --sysconfdir=/etc
    make
    make install

    systemctl enable vnstat
    systemctl restart vnstat

    vnstat --version
}


install_xray(){
    echo "[INFO] Installing latest official Xray-core..."

    mkdir -p /etc/xray /var/log/xray /run/xray
    chown -R firenet:firenet /etc/xray /var/log/xray /run/xray

    echo "$DOMAIN" > /etc/xray/domain
    curl -s ipinfo.io/city > /etc/xray/city
    curl -s ipinfo.io/org | cut -d " " -f 2-10 > /etc/xray/isp

    # Detect latest official Xray version
    XRAY_TAG="$(curl -s https://api.github.com/repos/XTLS/Xray-core/releases/latest \
      | jq -r .tag_name)"

    if [[ -z "$XRAY_TAG" || "$XRAY_TAG" == "null" ]]; then
        echo "[ERROR] Failed to fetch latest Xray version"
        exit 1
    fi

    echo "[INFO] Latest Xray version: $XRAY_TAG"

    # Download & install (amd64)
    cd /tmp || exit
    curl -fsSL \
      "https://github.com/XTLS/Xray-core/releases/download/${XRAY_TAG}/Xray-linux-64.zip" \
      -o xray.zip

    unzip -o xray.zip xray
    install -m 755 xray /usr/sbin/xray

    rm -f xray.zip xray

    # Fetch config and inject UUID
    wget -q -O /etc/xray/config.json \
      "https://gitlab.com/mrakibul020/radeveloperserversc/-/raw/main/v2ray/xray_config.json"

    sed -i "s/RaDeveloper/${UUID}/g" /etc/xray/config.json

    # systemd service
    cat >/etc/systemd/system/xray.service <<'EOF'
[Unit]
Description=Xray Service
Documentation=https://github.com/XTLS/Xray-core
After=network.target nss-lookup.target

[Service]
User=firenet
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ExecStart=/usr/sbin/xray run -config /etc/xray/config.json
Restart=on-failure
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF

    systemctl daemon-reload
    systemctl enable xray
    systemctl restart xray

    echo "[INFO] Xray installed and running (TLS + WS ready)"
}


