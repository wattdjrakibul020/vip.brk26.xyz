echo "tcp_bbr" >> /etc/modules-load.d/modules.conf
fi
modprobe tcp_bbr

# Verify
sysctl net.ipv4.tcp_congestion_control
lsmod | grep bbr && echo "✅ BBR is active" || echo "⚠️ BBR failed to load"
INSTALL_BBR=true
}

